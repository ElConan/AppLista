<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLista.Views.MainPage"
             Title="Mis Notas"
             Shell.BackgroundColor="#F5F5F5"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="Auto,Auto,*">
      

        <SearchBar Grid.Row="0"
                   Placeholder="Buscar notas..."
                   TextChanged="OnSearchTextChanged"
                   Margin="15,10"
                   HeightRequest="42"
                   WidthRequest="350"
                   BackgroundColor="White"
                   TextColor="Black"/>

        <Button Grid.Row="1"
                Text="Exportar Notas"
                Margin="15,5"
                BackgroundColor="#4CAF50"
                TextColor="White"
                CornerRadius="8"
                WidthRequest="250"
                Clicked="OnExport"/>

        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Notas}"
                        SelectionMode="Single"
                        SelectionChanged="OnNoteSelected">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Margin="12,6"
                           Padding="12"
                           BackgroundColor="White"
                           BorderColor="#E0E0E0"
                           CornerRadius="12"
                           HasShadow="True"
                           InputTransparent="True">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding titulo}"
                                   FontAttributes="Bold"
                                   FontSize="18"
                                   TextColor="#212121"/>

                            <Label Text="{Binding contenido}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"
                                   TextColor="#616161"/>

                            <Label Text="{Binding fecha_act}"
                                   FontSize="11"
                                   TextColor="#9E9E9E"
                                   HorizontalOptions="End"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>

        <Button Text="+"
                FontSize="28"
                WidthRequest="65"
                HeightRequest="65"
                CornerRadius="32"
                BackgroundColor="#3F51B5"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddNote"
                Shadow="{Shadow Brush=Black, Radius=10, Opacity=0.3}"/>

    </Grid>

</ContentPage>