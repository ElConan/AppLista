<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppLista.Views.MainPage"
             Title="Mis Notas">

    <Grid>
        <CollectionView ItemsSource="{Binding Notas}"
                        SelectionMode="Single">

            <CollectionView.ItemTemplate>
                <DataTemplate>

                    <Frame Margin="10"
                           Padding="10"
                           BorderColor="LightGray">

                        <VerticalStackLayout>

                            <Label Text="{Binding titulo}"
                                   FontAttributes="Bold"
                                   FontSize="18"/>

                            <Label Text="{Binding contenido}"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="2"/>

                            <Label Text="{Binding fecha_act}"
                                   FontSize="12"
                                   TextColor="Gray"/>

                        </VerticalStackLayout>

                    </Frame>

                </DataTemplate>
            </CollectionView.ItemTemplate>

        </CollectionView>
        
        <Button Text="+"
                FontSize="30"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="#2196F3"
                TextColor="White"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="20"
                Clicked="OnAddNote"/>

    </Grid>

</ContentPage>